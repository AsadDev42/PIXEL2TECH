# Optional local configuration. Copy this file to .env.local and fill only what you use.
# Never place private values in VITE_* variables.

# Transactional email (contact form and booking confirmations).
RESEND_API_KEY=
EMAIL_FROM=
CONTACT_OWNER_EMAIL=

# Google Calendar booking. See docs/google-calendar-booking.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=

# Local Prisma connection; production uses Composer-injected configuration.
COMPOSER_DATABASE_URL=

# Live HTTP verification scripts (optional, defaults to http://localhost:4173).
VERIFY_BASE_URL=http://localhost:4173
